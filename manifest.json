{
  "manifest_version": 3,
  "name": "Secure Semantic Vault",
  "version": "1.2",
  "permissions": ["storage", "unlimitedStorage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["crypto-util.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}