{
    "manifest_version": 3,
    "name": "Secure Semantic Vault",
    "version": "1.3",
    "permissions": [
        "storage", 
        "unlimitedStorage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["crypto-util.js", "content.js"],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    }
}